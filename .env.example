# EdLink MCP — contoh environment untuk deployment HTTP.
# Salin ke .env di VM lalu isi nilainya. JANGAN commit file .env.
#   cp .env.example .env
#   chmod 600 .env

# --- Transport ---
# stdio (default lokal) atau http (Streamable HTTP publik)
EDLINK_MCP_TRANSPORT=http
# Bind di dalam VM. Jangan diubah ke 127.0.0.1 kalau reverse proxy
# berada di container/host lain; 0.0.0.0 aman karena port tidak
# dipublikasikan mentah-mentah.
EDLINK_MCP_HOST=0.0.0.0
EDLINK_MCP_PORT=8765

# --- Autentikasi endpoint MCP (WAJIB) ---
# Token bearer statis. Server menolak start kalau kosong.
# Buat dengan: openssl rand -hex 32
EDLINK_MCP_AUTH_TOKEN=GANTI_DENGAN_TOKEN_ACAK_64_HEX

# URL publik server ini, tanpa /mcp. Dipakai sebagai issuer + resource server.
# Contoh: https://edlink-mcp.contoh.app
EDLINK_MCP_ISSUER_URL=https://GANTI_DENGAN_HOST_PUBLIK

# --- Transport security (DNS rebinding / Host / Origin) ---
# Daftar Host header yang diterima, dipisah koma, sertakan port bila non-443.
# Contoh: edlink-mcp.contoh.app,localhost:8765,127.0.0.1:8765
EDLINK_MCP_ALLOWED_HOSTS=GANTI_DENGAN_HOST_PUBLIK,localhost:8765,127.0.0.1:8765

# Origin browser yang diizinkan, dipisah koma. Kosongkan kalau hanya
# klien non-browser (ChatGPT) yang memakai endpoint ini.
EDLINK_MCP_ALLOWED_ORIGINS=

# --- Kredensial EdLink (pilih salah satu metode) ---
# Metode 1: token siap pakai (paling sederhana untuk server)
EDLINK_TOKEN=

# Metode 2: email + password (dipakai untuk login otomatis)
EDLINK_EMAIL=
EDLINK_PASSWORD=

# --- Opsional ---
# Folder tujuan edlink_sync_materi.py (default ~/Documents/Kuliah)
EDLINK_KULIAH_DIR=
